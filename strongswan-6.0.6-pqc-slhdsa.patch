# strongSwan 6.0.6 SLH-DSA supplement patch
# Applied after strongswan-6.0.6-pqc.patch + strongswan-6.0.6-pqc-supplement.patch.
# Adds SLH-DSA-SHA2-128s / 192s / 256s (FIPS 205) support to strongSwan core.
# PKCS#11 plugin changes handled separately via strongswan-pkcs11/ copy.
#
--- a/src/libstrongswan/asn1/asn1.c
+++ b/src/libstrongswan/asn1/asn1.c
@@ -61,6 +61,9 @@
