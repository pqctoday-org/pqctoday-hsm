 		case OID_ML_DSA_65:
 		case OID_ML_DSA_87:
+		case OID_SLH_DSA_SHA2_128S:
+		case OID_SLH_DSA_SHA2_192S:
+		case OID_SLH_DSA_SHA2_256S:
 			parameters = chunk_empty;
 			break;
 		default:
