<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.pqctoday</groupId>
  <artifactId>softhsmv3-jce-remote</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <!-- JCA/JCE provider bridging javax.crypto/java.security to the
       softhsmrustv3 engine via gRPC (remoting/grpc), NOT the local
       PKCS#11 FFM path ../JavaJCE/ uses. Plan
       docs/implementation-plan-jca-remaining-gaps-2026-08-25.md §7
       (WS-E), decision Q2 ("full workstream in this plan").

       A SEPARATE Maven module/artifact from ../JavaJCE/, per that
       plan's own E1 architecture decision — NOT a network-dependency
       addition to the core provider. The remote surface is narrower
       than the local one by real proto contract, not by omission:
       exactly Ed25519 + ML-DSA-44/65/87 + ML-KEM-512/768/1024 (7
       Algorithm enum values, confirmed reading
       remoting/proto/proto/pkcs11_remote.proto directly — no SLH-DSA,
       no EC/ECDSA, no RSA, no symmetric anything; widening this is an
       explicit follow-on with its own gate, plan §7 E5).

       Depends on the core jar (com.pqctoday:softhsmv3-jce) — install it
       into the local Maven repo first (`cd ../JavaJCE && mvn install
       -DskipTests`) before building this module; there is no reactor
       parent pom aggregating the two (deliberately — ../JavaJCE/pom.xml
       stays a standalone, independently-buildable project, unchanged by
       this module's existence). -->
  <properties>
    <maven.compiler.release>27</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <grpc.version>1.83.1</grpc.version>
    <protobuf.version>4.36.0</protobuf.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.pqctoday</groupId>
      <artifactId>softhsmv3-jce</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <!-- Pinned explicitly to match protocArtifact's version exactly
         below — grpc-protobuf:1.83.1 transitively pulls an OLDER
         protobuf-java than protoc 4.36.0 generates code against
         (confirmed live: without this pin, the generated
         Pkcs11RemoteOuterClass.java fails to compile against the
         transitively-resolved runtime — missing RuntimeVersion class,
         wrong parseUnknownField signature, missing
         getMessageType(int)/isStringEmpty/resolveAllFeaturesImmutable).
         protoc and protobuf-java must be the same version; this
         dependency forces Maven's nearest-wins resolution to pick
         4.36.0 over whatever grpc-protobuf declares. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>
    <!-- gRPC client — netty-shaded (bundled Netty, no version conflicts
         with anything else on the classpath), protobuf codec, and the
         async/blocking stub base classes. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <!-- Generated grpc-java stub code references @javax.annotation.Generated,
         which JDK 9+ no longer ships in the base JDK — standard grpc-java
         project dependency, not optional. -->
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- os-maven-plugin resolves ${os.detected.classifier} (e.g.
         linux-x86_64) — required by the protoc/protoc-gen-grpc-java
         artifact classifiers below, which ship native per-platform
         executables rather than portable jars. -->
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <!-- Proto consumed VERBATIM from remoting/proto/proto/ (relative
           protoSourceRoot below) — not copied into this module's own
           src tree, so it can never drift from the Rust server's own
           schema (plan §1 correction 1's own emphasis: "not a copy that
           can drift"). -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <protoSourceRoot>${project.basedir}/../remoting/proto/proto</protoSourceRoot>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- grpc-netty-shaded loads a bundled native Netty transport via
               System.loadLibrary() from the unnamed module (the test
               classpath) — JDK 27's restricted-native-access enforcement
               (JEP 472) warns on every such call today and will BLOCK it
               outright in a future JDK release unless the module is
               explicitly allow-listed. ALL-UNNAMED matches how this
               module is actually run (plain classpath, no module-info). -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
      </plugin>
    </plugins>
  </build>
</project>
