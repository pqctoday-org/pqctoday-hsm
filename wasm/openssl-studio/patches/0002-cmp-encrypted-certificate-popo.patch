+#ifndef OPENSSL_NO_CMS
+/* Encrypt the DER certificate directly, not a nested SignedData object.
+ * The complete CMP response is protected by ossl_cmp_msg_protect().
+ */
+static OSSL_CRMF_ENCRYPTEDKEY *enc_certificate(OSSL_CMP_CTX *ctx,
+    X509 *cert, const X509 *recipient)
+{
+    BIO *der = NULL;
+    EVP_CIPHER *cipher = NULL;
+    STACK_OF(X509) *recips = NULL;
+    CMS_ContentInfo *cms = NULL;
+    CMS_EnvelopedData *env = NULL;
+    OSSL_CRMF_ENCRYPTEDKEY *result = NULL;
+
+    if ((der = BIO_new(BIO_s_mem())) == NULL
+        || (recips = sk_X509_new_null()) == NULL
+        || !sk_X509_push(recips, (X509 *)recipient)
+        || i2d_X509_bio(der, cert) <= 0
+        || (cipher = EVP_CIPHER_fetch(ctx->libctx, "AES-256-CBC", ctx->propq)) == NULL)
+        goto end;
+    cms = CMS_encrypt_ex(recips, der, cipher, CMS_BINARY, ctx->libctx, ctx->propq);
+    if (cms == NULL || OBJ_obj2nid(CMS_get0_type(cms)) != NID_pkcs7_enveloped)
+        goto end;
+    env = CMS_EnvelopedData_dup(cms->d.envelopedData);
+    if (env == NULL)
+        goto end;
+    result = OSSL_CRMF_ENCRYPTEDKEY_init_envdata(env);
+    if (result != NULL)
+        env = NULL; /* ownership transferred */
+end:
+    M_ASN1_free_of(env, CMS_EnvelopedData);
+    CMS_ContentInfo_free(cms);
+    sk_X509_free(recips); /* borrowed recipient */
+    EVP_CIPHER_free(cipher);
+    BIO_free(der);
+    return result;
+}
+#endif
