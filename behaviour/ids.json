{
  "$comment": "Single source for the 8-byte behaviour record's id tables. Edit THIS file, then run `python3 behaviour/gen.py` to regenerate rust/src/behaviour/ids.rs and src/lib/common/BehaviourIds.h (both checked in; tests fail if they drift). Ids are append-only: never renumber, never reuse.",
  "version": 1,
  "record": {
    "bytes": ["src", "op", "alg", "result", "client", "size", "latency", "dt"],
    "size": "floor(log2(input bytes)); 0 when 0 or unknown",
    "latency": "floor(log2(microseconds)); 0 when unknown",
    "dt": "floor(log2(microseconds since the previous record from this process)); 255 for the first record",
    "client": "1 + (fnv1a32(identity) % 255); 0 = local / no identity"
  },
  "src": [
    { "id": 1, "name": "kmip-data" },
    { "id": 2, "name": "kmip-admin" },
    { "id": 3, "name": "policy" },
    { "id": 4, "name": "p11-remoting-grpc" },
    { "id": 5, "name": "p11-remoting-rest" },
    { "id": 6, "name": "p11-local" },
    { "id": 7, "name": "tls" },
    { "id": 8, "name": "auth" }
  ],
  "op": {
