    "auth-fail": ["AuthenticationNotSuccessful", "NotAuthorised", "BadPassword", "InvalidTicket", "AttestationRequired", "AttestationFailed"],
    "internal-error": ["InternalServerError", "CryptographicFailure", "ProtectionStorageUnavailable", "PrivateProtectionStorageUnavailable", "PublicProtectionStorageUnavailable", "ServerLimitExceeded", "ResponseTooLarge"]
  },
  "http_status_class": {
    "$comment": "kmip-admin records: HTTP status -> result class. 2xx/3xx -> ok; 401/403 -> auth-fail; other 4xx -> caller-error; 5xx -> internal-error."
  },
  "vectors": {
    "$comment": "Golden records. Both engines' tests encode these inputs and must produce exactly `hex` (little-endian u64 = byte 0 first). `dt_us` is the gap the writer computed; -1 means 'first record'.",
    "entries": [
      { "src": "p11-local", "op": "C_Sign", "alg": "ML-DSA-65", "result": "ok", "client": 0, "size_bytes": 32, "latency_us": 1500, "dt_us": -1, "hex": "0602020000050aff" },
      { "src": "p11-remoting-grpc", "op": "C_GenerateKeyPair", "alg": "ML-KEM-768", "result": "ok", "client": 0, "size_bytes": 0, "latency_us": 900, "dt_us": 2048, "hex": "040705000000090b" },
      { "src": "p11-local", "op": "C_SignInit", "alg": "", "result": "caller-error", "client": 0, "size_bytes": 0, "latency_us": 0, "dt_us": 1, "hex": "0601000300000000" },
      { "src": "kmip-data", "op": "Sign", "alg": "ML-DSA-87", "result": "policy-deny", "client": 17, "size_bytes": 0, "latency_us": 12000, "dt_us": 1000000, "hex": "0121030111000d13" },
      { "src": "auth", "op": "remoting-pin", "alg": "", "result": "auth-fail", "client": 200, "size_bytes": 0, "latency_us": 0, "dt_us": 0, "hex": "08030002c8000000" },
      { "src": "tls", "op": "kmip", "alg": "", "result": "ok", "client": 0, "size_bytes": 0, "latency_us": 0, "dt_us": 65536, "hex": "0701000000000010" }
