    { "id": 4, "name": "internal-error" },
    { "id": 5, "name": "warn-rekey" }
  ],
  "ckr_class": {
    "$comment": "CK_RV -> result class. CKR_OK -> ok; listed values -> the named class; any other non-zero CK_RV -> caller-error.",
    "auth-fail": ["0x000000A0", "0x000000A1", "0x000000A2", "0x000000A3", "0x000000A4", "0x000001B8", "0x00000100", "0x00000101", "0x00000102", "0x00000103", "0x00000104", "0x00000105", "0x000000B5", "0x000000B7", "0x000000B8"],
