diff -ruN a/crypto/fipsmodule/cpucap/internal.h b/crypto/fipsmodule/cpucap/internal.h
--- a/crypto/fipsmodule/cpucap/internal.h
+++ b/crypto/fipsmodule/cpucap/internal.h
@@ -254,6 +254,17 @@
            (OPENSSL_armcap_P & ARMV8_APPLE_M) != 0;
 }
 
+// Cortex-A53 and Cortex-A55 are 2-wide in-order cores with a single
+// multiply-accumulate pipe. They are correctly classified as not
+// wide-multiplier capable, but unlike the out-of-order cores in that class
+// they do not benefit from the s2n-bignum Montgomery kernels, which are
+// scheduled for Graviton2. Measured on a Cortex-A55 at 1.8 GHz, RSA sign with
+// the key parsed once, s2n-bignum path vs the scalar armv8-mont path:
+// 2048-bit 137.7 vs 177.5 op/s, 3072-bit 33.8 vs 54.8, 4096-bit 20.5 vs 25.0.
+OPENSSL_INLINE int CRYPTO_is_ARMv8_in_order_small_core(void) {
+  return (OPENSSL_armcap_P & ARMV8_CORTEX_A5X) != 0;
+}
+
 OPENSSL_INLINE int CRYPTO_is_ARMv8_DIT_capable(void) {
   return (OPENSSL_armcap_P & (ARMV8_DIT | ARMV8_DIT_ALLOWED)) ==
     (ARMV8_DIT | ARMV8_DIT_ALLOWED);
diff -ruN a/include/openssl/arm_arch.h b/include/openssl/arm_arch.h
--- a/include/openssl/arm_arch.h
+++ b/include/openssl/arm_arch.h
@@ -40,7 +40,7 @@
 
 // The Neoverse N1, V1, V2, V3, and Apple M1 micro-architectures are detected to
 // allow selecting the fasted implementations for SHA3/SHAKE and AES-GCM.
-// Combination of all CPU indicator bits: 0x47080
+// Combination of all CPU indicator bits: 0xC7080
 // NOTE: If you add further CPU indicator bits, adjust
 // "Test algorithm dispatch without CPU indicator bits" in util/all_tests.json.
 #define ARMV8_NEOVERSE_N1 (1 << 7)
@@ -48,8 +48,14 @@
 #define ARMV8_APPLE_M (1 << 13)
 #define ARMV8_NEOVERSE_V2 (1 << 14)
 #define ARMV8_NEOVERSE_V3 (1 << 18)
+// ARMV8_CORTEX_A5X marks the small in-order Arm application cores (Cortex-A53
+// and Cortex-A55). They are detected so that big-integer code can avoid the
+// s2n-bignum Montgomery kernels, which are scheduled for an out-of-order core
+// and lose to the scalar armv8-mont path here; see
+// |CRYPTO_is_ARMv8_in_order_small_core| and montgomery.c.
+#define ARMV8_CORTEX_A5X (1 << 19)
 
-// Combination of CPU indicator bits and Armv8 Neon extension bits: 0x478fc
+// Combination of CPU indicator bits and Armv8 Neon extension bits: 0xC78fc
 
 // ARMV8_DIT indicates support for the Data-Independent Timing (DIT) flag.
 #define ARMV8_DIT (1 << 15)
@@ -74,6 +80,8 @@
 
 # define ARM_CPU_IMP_ARM           0x41
 
+# define ARM_CPU_PART_CORTEX_A53   0xD03
+# define ARM_CPU_PART_CORTEX_A55   0xD05
 # define ARM_CPU_PART_CORTEX_A72   0xD08
 # define ARM_CPU_PART_N1           0xD0C
 # define ARM_CPU_PART_V1           0xD40
