@@ -91,6 +91,12 @@
       // CPU capabilities of N1 are a subset of CPU capabilities of V3
       OPENSSL_armcap_P |= ARMV8_NEOVERSE_N1;
     }
+    if (MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_ARM,
