 #define CKM_JUNIPER_CBC128              (0x1062UL)
@@ -1543,6 +1602,27 @@ struct ck_function_list_3_0
   CK_C_VerifyMessageBegin C_VerifyMessageBegin;
   CK_C_VerifyMessageNext C_VerifyMessageNext;
