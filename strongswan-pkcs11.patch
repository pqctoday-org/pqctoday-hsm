@@ -748,6 +794,19 @@ typedef unsigned long ck_mechanism_type_t;
 #define CKM_EC_EDWARDS_KEY_PAIR_GEN     (0x1055UL)
 #define CKM_EC_MONTGOMERY_KEY_PAIR_GEN  (0x1056UL)
