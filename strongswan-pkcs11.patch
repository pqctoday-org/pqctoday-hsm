+/**
+ * CKA_EC_PARAMS value for CKK_EC_EDWARDS Ed25519 keys on this connector's
+ * softhsmv3 target: a DER PrintableString "edwards25519" ("13 0c" + ASCII),
+ * mirroring ed448_ec_params above exactly (same OSSL::oid2ByteString
