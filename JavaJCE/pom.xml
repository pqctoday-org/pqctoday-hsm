<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.pqctoday</groupId>
  <artifactId>softhsmv3-jce</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <!-- JDK 27 JCA/JCE provider bridging javax.crypto/java.security to this
       repo's PKCS#11 v3.2 engine. Replaces the removed JavaJCE/ placeholder
       (see docs/implementation-plan-jdk27-jca-provider-2026-08-24.md and
       the CHANGELOG entry for what it replaced and why).

       No SOFTWARE CRYPTO dependencies: every cryptographic operation
       routes to the token via the FFM native layer (java.lang.foreign, no
       JDK-internal APIs) — this provider never computes a signature, hash,
       or key on the JVM side. bcprov-jdk18on below is the one exception,
       and it is NOT used for crypto: only its org.bouncycastle.asn1
       package (ASN1Integer/DLSequence/ASN1Sequence — pure DER syntax) is
       used, to encode/decode the ECDSA-Sig-Value wire format PKCS#11's
       raw r‖s output must be converted to/from for JCA interop (see
       P11ECDSASignatureSpi's javadoc for why that conversion exists at
       all). No BC Provider is ever registered
       (Security.addProvider(new BouncyCastleProvider()) never appears in
       this module) and no BC Cipher/Signature/KeyPairGenerator class is
       ever used — same boundary as nlohmann::json in the sandbox's C++
       REST sample or org.json in its Java sample: a small, established
       library for wire-format syntax, not a crypto engine.

       Release target: JDK 27 (this project's target throughout). Built
       against JDK 27 RC directly; GA is 2026-09-15, and the RC could in
       principle still shift slightly before then (see the plan's own
       risk register) — revisit if it does. -->
  <properties>
    <maven.compiler.release>27</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <bouncycastle.version>1.85.2</bouncycastle.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- Same FFM native-access requirement as the runtime jar. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
